location                 = "eastus"
environment              = "dev"
resource_group_name      = "rg-sasb-dev"
acr_name                 = "sasbdevacr001"
aks_name                 = "aks-sasb-dev"
aks_dns_prefix           = "aks-sasb-dev"
key_vault_name           = "kv-sasb-dev-001"
uami_name                = "uami-sasb-dev"
federated_credential_name = "secure-service-fic-dev"
